# Postgres (Neon)
DATABASE_URL=

# Neon Object Storage — an S3-compatible credential scoped to the routicle project's branch.
# Create one at console.neon.tech > your project > branch > Credentials > Create credential
# (check both storage:read and storage:write), then copy the four values it shows you once.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2

# Neon Auth (Managed Better Auth) — the branch's Auth base URL, from console.neon.tech > project > branch > Auth.
# Must be prefixed VITE_ so Vite bakes it into the client bundle at build time.
# The /api/admin/* routes also read this server-side: they forward the request's
# session cookie to {VITE_NEON_AUTH_URL}/get-session and trust only what comes back.
VITE_NEON_AUTH_URL=

# --- Admin access ---
# Comma-separated emails that are always platform admins. This exists to bootstrap
# the first one — there is no way to grant admin through the UI before an admin
# exists. Everyone granted afterwards lives in the platform_admins table, so this
# can stay as just the founding account.
# ADMIN_EMAILS=you@example.com

# --- Billing (Paystack) ---
# Secret key from dashboard.paystack.com > Settings > API Keys & Webhooks.
# sk_test_... works end-to-end with Paystack's test cards; swap to sk_live_ for real charges.
PAYSTACK_SECRET_KEY=

# Currency to charge in. Defaults to USD so buyers are charged exactly the price
# shown on the pricing page. If your Paystack account is NGN-only, set NGN here
# AND set your own USD_TO_NGN_RATE — no exchange rate is assumed for you.
PAYSTACK_CURRENCY=USD
# USD_TO_NGN_RATE=1600

# Optional: Paystack Plan codes turn a checkout into a true auto-renewing subscription
# (Paystack bills the card each cycle by itself). Create the plans in the Paystack
# dashboard, then paste their codes here. Leave unset to charge one-off instead,
# in which case the period end is tracked in our own `subscriptions` table.
# PAYSTACK_PLAN_STANDARD_MONTHLY=PLN_xxxxxxxx
# PAYSTACK_PLAN_STANDARD_ANNUAL=PLN_xxxxxxxx
# PAYSTACK_PLAN_EXPRESS_MONTHLY=PLN_xxxxxxxx
# PAYSTACK_PLAN_EXPRESS_ANNUAL=PLN_xxxxxxxx

# --- Email (workspace invites) ---
# Resend is the transport used when this is set. Get a key at resend.com/api-keys.
RESEND_API_KEY=

# Until a sending domain is verified, Resend's shared onboarding@resend.dev
# sender only delivers to the Resend account owner's own address. Verify a
# domain at resend.com/domains, then set MAIL_FROM to an address on it.
# MAIL_FROM=Routicle <invites@yourdomain.com>

# SMTP fallback, used only when RESEND_API_KEY is unset. Gmail needs an App
# Password (myaccount.google.com/apppasswords), never the account password.
# SMTP_USER=
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Absolute base URL used to build invite links. Falls back to the request host,
# which is right on Vercel but wrong behind a proxy or custom domain.
# APP_URL=https://routicle.vercel.app

# --- Upload limits ---
# All optional. Defaults: 5GB per file, 20GB per submission, and no per-creator
# or whole-library ceiling. The per-file value is signed into the presigned URL,
# so it is enforced by object storage itself rather than trusted from the browser.
# MAX_UPLOAD_BYTES=5368709120
# MAX_SUBMISSION_BYTES=21474836480
# MAX_CREATOR_BYTES=
# MAX_LIBRARY_BYTES=
