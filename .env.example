# Postgres (Neon)
DATABASE_URL=

# Neon Object Storage — an S3-compatible credential scoped to the routicle project's branch.
# Create one at console.neon.tech > your project > branch > Credentials > Create credential
# (check both storage:read and storage:write), then copy the four values it shows you once.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
